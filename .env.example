# ── Hyperliquid DEX ────────────────────────────────────────────────────────────
# Clé privée du wallet dédié au bot (ne JAMAIS utiliser le wallet principal)
HL_PRIVATE_KEY=your_private_key_here

# Conseillé : mettre ci-dessus la clé d'un « API wallet » (app.hyperliquid.xyz/API — elle peut trader mais
# pas retirer les fonds) et ici l'adresse du compte. Vide : HL_PRIVATE_KEY est la clé du compte lui-même.
HL_ACCOUNT_ADDRESS=

# HL_TESTNET=1 → testnet (argent virtuel) | HL_TESTNET=0 → mainnet (argent réel)
HL_TESTNET=1

# ── Stratégie tendance ─────────────────────────────────────────────────────────
# Notionnel total des positions / équité (0.5 = 50 %, réparti sur les 5 coins)
TREND_EXPOSURE=0.5
# 1 = aucun ordre réel : positions fantômes au prix du marché (validation)
GHOST_ONLY=1
# Mode fantôme seulement : capital fictif du test (0 = solde réel)
PAPER_EQUITY=0

# ── Capital ────────────────────────────────────────────────────────────────────
# 0 = tailles calculées sur tout le solde | ex: 150 = au plus 150 $
MAX_LIQUIDITY=0
# Levier croisé : fixe seulement la marge bloquée, l'exposition vient de TREND_EXPOSURE
LEVERAGE=5

# Discord : webhook pour les alertes + résumé périodique "bot actif" (0 = désactivé)
DISCORD_WEBHOOK_URL=
HEARTBEAT_HOURS=6
