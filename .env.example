# ── Hyperliquid DEX ────────────────────────────────────────────────────────────
# Clé privée du wallet dédié au bot (ne JAMAIS utiliser le wallet principal)
HL_PRIVATE_KEY=your_private_key_here

# HL_TESTNET=1 → testnet (argent virtuel) | HL_TESTNET=0 → mainnet (argent réel)
HL_TESTNET=1

# ── Stratégie ──────────────────────────────────────────────────────────────────
# trend = tendance journalière (LONG/SHORT selon le vote des variations sur 14, 28 et 56 jours, SL 3×ATR D1)
# scalp = ancien scalping M1/M5 (aucun avantage mesuré sur le hasard après frais)
STRATEGY=trend
# Notionnel total des positions tendance / équité (0.5 = 50 %, réparti sur les 5 coins)
TREND_EXPOSURE=0.5
# 1 = aucun ordre réel : positions fantômes au prix du marché (validation)
GHOST_ONLY=1

# ── Capital ────────────────────────────────────────────────────────────────────
# 0 = gérer tout le portefeuille automatiquement | ex: 50 = limiter à 50$
MAX_LIQUIDITY=0

# Pourcentage du capital par trade (0.10 = 10% → 10$ par trade)
CAPITAL_PCT=0.10

# Levier par trade (5 = 5x → ~50$ notionnel par position)
LEVERAGE=5

# ── Filtres de signal ──────────────────────────────────────────────────────────
MIN_MOVE_PCT=0.0002
VOL_MULTIPLIER=1.2

# ── Limites ────────────────────────────────────────────────────────────────────
MAX_TRADES=0

# Perte max journalière (% du capital total) avant d'arrêter de trader ce jour
MAX_DAILY_LOSS_PCT=3.0

# Heures UTC pendant lesquelles le bot est actif (7h-22h = liquidité Europe+US)
SESSION_START_UTC=7
SESSION_END_UTC=22

# Discord : webhook pour les alertes + résumé périodique "bot actif" (0 = désactivé)
DISCORD_WEBHOOK_URL=
HEARTBEAT_HOURS=6
